NODE_ENV=development
PORT=5000

# PostgreSQL connection string for your local database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/healthcare_db?schema=public"

# Use unique, randomly generated secrets for each environment.
JWT_SECRET=replace-with-a-long-random-secret
EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
REFRESH_TOKEN_EXPIRES_IN=7d
RESET_PASS_TOKEN=replace-with-another-long-random-secret
RESET_PASS_TOKEN_EXPIRES_IN=15m

# Frontend route that handles password resets.
RESET_PASS_LINK=http://localhost:3000/reset-password

# Gmail credentials for password reset email delivery.
EMAIL=your-gmail-address@gmail.com
APP_PASS=your-google-app-password
